# SkinSense v2.0 Environment Configuration
# ─────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ── Core Security ──
SECRET_KEY=your_secret_key_here_change_in_production
FLASK_ENV=development          # Set to 'production' for live deployment

# ── AI / API Keys ──
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Server ──
PORT=5000
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ── Production Deployment ──
# For production, set ALL of the following:
#   FLASK_ENV=production
#   ALLOWED_ORIGINS=https://your-domain.com
#   SECRET_KEY=<strong-random-key-generated-with-secrets.token_hex(32)>
#
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
